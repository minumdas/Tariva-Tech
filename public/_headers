/*
  # ──────────────────────────────────────────────────────────────────────
  # Netlify / Vercel _headers file
  # (GitHub Pages does not support custom HTTP headers server-side;
  #  use this if you ever migrate to Netlify or Vercel)
  # ──────────────────────────────────────────────────────────────────────

  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none';
  X-XSS-Protection: 1; mode=block
  Cache-Control: no-store
